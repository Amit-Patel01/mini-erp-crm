{
  "info": {
    "_postman_id": "mini-erp-crm-collection-id",
    "name": "Mini ERP + CRM API Operations",
    "description": "Production API collection for Mini ERP + CRM Portal featuring Auth, Customers CRM, Product Inventory, Stock Movements, Sales Challans, and Analytics Dashboard.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Active User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Customer CRM",
      "item": [
        {
          "name": "Get Customers Directory",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers?search=&status=ACTIVE&customerType=WHOLESALE",
              "host": ["{{baseUrl}}"],
              "path": ["customers"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "status", "value": "ACTIVE" },
                { "key": "customerType", "value": "WHOLESALE" }
              ]
            }
          }
        },
        {
          "name": "Create Customer Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Rohan Mehta\",\n  \"businessName\": \"Summit Logistics & Trading\",\n  \"mobile\": \"9876599999\",\n  \"email\": \"rohan@summitlogistics.com\",\n  \"gstNumber\": \"27CBAAB1234A1Z9\",\n  \"customerType\": \"DISTRIBUTOR\",\n  \"address\": \"Plot 88, Logistics Hub, Thane West\",\n  \"status\": \"LEAD\",\n  \"followUpDate\": \"2026-08-15\",\n  \"notes\": \"Inquired about barcode scanners and thermal printers.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          }
        },
        {
          "name": "Log Customer Follow-Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Followed up via phone. Customer requested volume pricing.\",\n  \"followUpDate\": \"2026-08-20\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/:id/follow-up",
              "host": ["{{baseUrl}}"],
              "path": ["customers", ":id", "follow-up"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Products & Stock",
      "item": [
        {
          "name": "Get Inventory Catalog",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?lowStock=false",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Manual Stock Adjustment (IN/OUT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"<PRODUCT_ID>\",\n  \"quantity\": 20,\n  \"movementType\": \"IN\",\n  \"reason\": \"Supplier Inward Purchase Batch #8812\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/stock-movements",
              "host": ["{{baseUrl}}"],
              "path": ["stock-movements"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Sales Challans",
      "item": [
        {
          "name": "Get Challans List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans?status=CONFIRMED",
              "host": ["{{baseUrl}}"],
              "path": ["challans"]
            }
          }
        },
        {
          "name": "Create Draft or Confirmed Challan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"<CUSTOMER_ID>\",\n  \"status\": \"DRAFT\",\n  \"items\": [\n    {\n      \"productId\": \"<PRODUCT_ID>\",\n      \"quantity\": 5\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": ["{{baseUrl}}"],
              "path": ["challans"]
            }
          }
        },
        {
          "name": "Confirm Challan (Atomic Stock Lock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id", "confirm"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Dashboard Analytics",
      "item": [
        {
          "name": "Get Operational Control Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "stats"]
            }
          }
        }
      ]
    }
  ]
}
